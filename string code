#include<stdio.h>
int main() {
    char str[100];
    int length=0,i;

    printf("enter a string: ");
    scanf("%s",str);

    //find length without strlen()
    while (str[length]!='\0') {
        length++;
    }

    printf("length of the string=%d\n",length);

    //reverse the string without strrev()
    printf("reversed string= ");
    for (i=length-1;i>=0;i--) {
        printf("%c",str[i]);
    }
    printf("\n");
     
    return 0;
    
}
